# Copy to .env and change every CHANGE_ME value before deploying.

POSTGRES_USER=soma
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
POSTGRES_DB=soma_db

# JWT signing key for admin login
SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET

# Use :80 until a domain points at the server.
# Then switch to your domain, e.g. somastudio.gr  (Caddy will issue HTTPS)
SITE_ADDRESS=:80

# Optional booking emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@somastudio.gr
